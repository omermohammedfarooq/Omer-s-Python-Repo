# 12. MAIN PROGRAM
# ---------------------------------------------------------

def main() -> None:

    print("=" * 60)
    print("ADVANCED SORTING ALGORITHM SUITE")
    print("=" * 60)

    validate_algorithms()

    print("\nBenchmark Results")
    print("-" * 60)

    results = benchmark(2000)

    for result in results:
        print(
            f"{result.algorithm:<20}"
            f"{result.execution_time:.6f} seconds"
        )

    print("\nExample:")
    data = [42, 17, 8, 99, 23, 4, 17, 56]

    print("Original:", data)
    print("Quick Sort:", quick_sort(data))
    print("Merge Sort:", merge_sort(data))
    print("Heap Sort:", heap_sort(data))


if __name__ == "__main__":
    main()
